PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/stock_insight
JWT_SECRET=stock_insight_jwt_super_secure_secret_key_2026_production
JWT_EXPIRES_IN=7d
PYTHON_SERVICE_URL=http://127.0.0.1:8000
CLIENT_ORIGIN=http://localhost:8501

# Testing & Offline Resilience
# When microservices are off during testing, the backend automatically serves DB cache and fallback data
MOCK_MICROSERVICE=false
